    \uC911\uD654\uAE30 \uD0C0\uC6CC\uC785\uB2C8\uB2E4.\n\uCCB4\uB825\uC774 \uB192\uC740
    \uBAAC\uC2A4\uD130\uB098 \uBB49\uCE5C \uBAAC\uC2A4\uD130\uC5D0\uAC8C \uD6A8\uACFC\uC801\uC785\uB2C8\uB2E4."
  statInfo: "\uBE44\uC6A9: 100G\n\uACF5\uACA9\uB825: 50\n\uACF5\uACA9\uC18D\uB3C4:
    \uB290\uB9BC\n\uC0AC\uAC70\uB9AC: \uB113\uC74C\n\uC5C5\uADF8\uB808\uC774\uB4DC:
    \uD3ED\uBC1C / \uACF5\uC131"
